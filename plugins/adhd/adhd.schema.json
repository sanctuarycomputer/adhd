{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADHD Config",
  "description": "Configuration schema for the ADHD plugin",
  "type": "object",
  "required": ["figma"],
  "properties": {
    "figma": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "description": "Figma design file URL (e.g., https://www.figma.com/design/ABC123xyz/My-File)"
        }
      },
      "additionalProperties": false
    },
    "naming": {
      "type": ["string", "boolean"],
      "description": "Naming convention for component and token names",
      "enum": ["kebab-case", "PascalCase", "camelCase", false],
      "default": "kebab-case"
    },
    "cssEntry": {
      "type": ["string", "null"],
      "description": "Path to the main CSS entry file (defaults to app/globals.css or src/app/globals.css)",
      "default": null
    }
  },
  "additionalProperties": false
}
